{#- Single-file daily preview. No external requests of any kind, and no
    figures or images from the papers by any route (PRD §5.7). -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Urban Currents — {{ issue.date }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<main class="uc-issue" data-date="{{ issue.date }}" data-run-id="{{ issue.run_id }}">
  <header class="uc-issue__masthead">
    <h1 class="uc-issue__title">Urban Currents</h1>
    <p class="uc-issue__date">{{ issue.date }}</p>
  </header>

  <p class="uc-scanmeta">
    {{ scan_meta.candidates_scanned }} candidates scanned<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.candidates_after_gate }} through the gate<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.items_published }} published<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.arxiv_categories }} arXiv categories<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.journals }} journals
    {%- if scan_meta.unreadable_count %}<span class="uc-scanmeta__sep">·</span>
    <span class="uc-scanmeta__unreadable">{{ scan_meta.unreadable_count }} without an open abstract</span>
    {%- endif %}
  </p>

  <section class="uc-headline{% if issue.quiet_day %} uc-headline--quiet{% endif %}">
    <p class="uc-headline__label">{% if issue.quiet_day %}No headline{% else %}Headline{% endif %}</p>
    <p class="uc-headline__line">
      {%- if issue.quiet_day -%}
      a quiet day in urban data science
      {%- else -%}
      {{ issue.headline.line }}
      {%- endif -%}
    </p>
  </section>

{# The synthesis layer sits between the headline and the cards (phase 0i).
   Every section is omitted when it has nothing to say — an empty section
   heading is worse than no section, because it reads as a failure rather than
   as a quiet day. Single-column block flow throughout: this has to survive an
   email client, where floats and grids do not. #}
  {% if synthesis and synthesis.has_content %}
  <section class="uc-synthesis">
    {% if synthesis.paragraph %}
    <p class="uc-synthesis__paragraph">{{ synthesis.paragraph }}</p>
    {% else %}
    <!-- paragraph omitted: {{ synthesis.omitted_reason }} -->
    {% endif %}

    {% if synthesis.deviations %}
    <div class="uc-synthesis__block" data-section="deviations">
      <h2 class="uc-synthesis__title">More than usual</h2>
      <ul class="uc-synthesis__list">
        {% for d in synthesis.deviations %}
        <li>{{ d.label }} — {{ d.today }} today, {{ d.baseline }} a day over the
          previous {{ d.window_days }} days</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if synthesis.anchors %}
    <div class="uc-synthesis__block" data-section="anchors">
      <h2 class="uc-synthesis__title">What today builds on</h2>
      <ul class="uc-synthesis__list">
        {% for a in synthesis.anchors %}
        <li>
          <span class="uc-synthesis__work">{{ a.title }}</span>
          {%- if a.cite %} <span class="uc-synthesis__cite">{{ a.cite }}</span>{% endif %}
          — cited by {{ a.count }} paper{{ 's' if a.count != 1 }} today
          {%- if a.note %}, {{ a.note }}{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if synthesis.clusters %}
    <div class="uc-synthesis__block" data-section="clusters">
      <h2 class="uc-synthesis__title">Read together</h2>
      <ul class="uc-synthesis__list">
        {% for c in synthesis.clusters %}
        <li>
          <span class="uc-synthesis__work">{{ c.titles[0] }}</span>
          shares {{ c.shared }} references with
          <span class="uc-synthesis__work">{{ c.titles[1] }}</span>
          {%- if c.partner_date %} ({{ c.partner_date }}){% endif %}
          {%- if c.shared_titles %}
          <ul class="uc-synthesis__shared">
            {% for t in c.shared_titles %}<li>{{ t }}</li>{% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if synthesis.institutions_today or synthesis.institutions_in_window or synthesis.repeat_authors %}
    <div class="uc-synthesis__block" data-section="who">
      <h2 class="uc-synthesis__title">Appearing more than once</h2>
      <ul class="uc-synthesis__list">
        {% for a in synthesis.repeat_authors %}
        <li>{{ a.name }} — {{ a.papers }} papers today</li>
        {% endfor %}
        {% for i in synthesis.institutions_today %}
        <li>{{ i.name }} — {{ i.papers }} papers today</li>
        {% endfor %}
        {% for i in synthesis.institutions_in_window %}
        <li>{{ i.name }} — {{ i.papers }} papers in {{ synthesis.window_days }} days</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if synthesis.first_internal_citation %}
    <p class="uc-synthesis__first">
      Today is the first time a paper in this digest cites another paper from it.
    </p>
    {% endif %}
  </section>
  {% endif %}

  <div class="uc-cards">
    {% for card in cards %}{% include "item_card.html.j2" %}{% endfor %}
  </div>

  {% if unreadable %}
  {# `Also published today`. Facts only: no sentence here was generated, because
     these items have no abstract to generate one from. The subtitle states the
     situation and names no publisher — the per-publisher tally lives in
     scan_meta for the monthly report, not in the reader's face every day. #}
  <section class="uc-also">
    <h2 class="uc-also__title">Also published today</h2>
    <p class="uc-also__note">
      These appeared today in journals we track. Their abstracts are not openly
      available, so we cannot summarise them.
    </p>
    <ul class="uc-also__list">
      {% for row in unreadable %}
      <li class="uc-also__item" data-work-key="{{ row.work_key }}">
        <span class="uc-also__item-title">
          {% if row.url %}<a href="{{ row.url }}" rel="noopener">{{ row.title }}</a>
          {% else %}{{ row.title }}{% endif %}
        </span>
        <span class="uc-also__byline">
          {{ row.authors }}
          {%- if row.affiliation %}<span class="uc-also__sep">·</span>{{ row.affiliation }}{% endif %}
          {%- if row.journal %}<span class="uc-also__sep">·</span>{{ row.journal }}{% endif %}
        </span>
        {% if row.topics or row.title_terms %}
        <span class="uc-also__tags">
          {% for t in row.topics %}<span class="uc-tag uc-tag--topic">{{ t }}</span>{% endfor %}
          {% for t in row.title_terms %}<span class="uc-tag uc-tag--from-title">{{ t }}</span>{% endfor %}
        </span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if status_changes %}
  <section class="uc-status-changes">
    <p class="uc-status-changes__title">Status changes</p>
    <ul>
      {% for change in status_changes %}
      <li data-work-key="{{ change.work_key }}">{{ change.text }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer class="uc-footer">
    Generated by urban-currents {{ pipeline_version }} · run {{ issue.run_id }}
    {# arXiv's API terms of use and brand guidelines require this wording
       exactly, including the disclaimer. It must not be paraphrased, and
       nothing here may suggest arXiv endorses or reviewed this service. #}
    <p class="uc-attribution">
      Thank you to arXiv for use of its open access interoperability. This
      service was not reviewed or approved by, nor does it necessarily express
      or reflect the policies or opinions of, arXiv.
    </p>
  </footer>
</main>
</body>
</html>
