  "summary": {
    "en": {
      "caveats": "The findings are based on qualitative self-reporting from storytelling workshops and interviews, rather than quantitative travel diaries or spatial accessibility modeling.",
      "what": "Through 14 storytelling workshops and 22 individual interviews with 73 low-income participants across Bergen, Stavanger, and Trondheim, this study documents how low-income groups are excluded from the benefits of Norway's low-carbon mobility transition. The analysis reveals that these residents face systemic barriers to accessing electric vehicle subsidies, new technologies, and public infrastructure, while receiving no recognition or reward for their existing low-emission travel habits.",
      "why": "It demonstrates that technology-centric sustainability policies, such as subsidizing electric vehicles, actively marginalize low-income populations and ignore low-cost, highly effective alternatives like e-bikes and affordable public transit."
    }
  },
