{#- One archive row grammar, shared by the home strip and the archive page, so
    the two cannot drift.

    A quiet day still has a row: it was still reviewed, and a gap in the list
    would say nothing happened rather than nothing was worth publishing. The
    grey bar carries a text label beside it — colour alone never carries the
    meaning.

    The bar is a <span> sized by an inline width percentage. That is the one
    place an inline style is unavoidable: the width is data, not design, and it
    differs per row. Everything else lives in the stylesheet. -#}
<ul class="uc-rows">
  {% for row in rows %}
  <li class="uc-row{% if row.quiet %} uc-row--quiet{% endif %}{% if row.missing %} uc-row--missing{% endif %}{% if row.backfilled %} uc-row--backfilled{% endif %}" data-date="{{ row.date }}">
    <span class="uc-row__date">
      {%- if row.missing %}{{ row.date }}
      {%- else %}<a href="{{ issue_href }}{{ row.date }}.html">{{ row.date }}</a>{% endif %}
    </span>
    <span class="uc-row__bar" aria-hidden="true">
      <span class="uc-row__fill" style="width: {{ (row.published / max_items * 100)|round|int }}%"></span>
    </span>
    <span class="uc-row__count">
      {%- if row.missing %}<span class="uc-chip uc-chip--missing">no issue</span>
      {%- elif row.quiet %}<span class="uc-chip">a quiet day</span>
      {%- else %}{{ row.published }} items{% endif %}
      {%- if row.backfilled %} <span class="uc-chip uc-chip--backfilled">filled in later</span>{% endif %}
    </span>
    {#- Full title in the DOM; the ellipsis is CSS. A string cut in Python is
        cut for a screen reader too. -#}
    <span class="uc-row__lead" title="{{ row.lead_title or row.reason }}">
      {%- if row.missing %}<span class="uc-row__reason">{{ row.reason }}</span>
      {%- else %}{{ row.lead_title }}{% endif %}
    </span>
    <span class="uc-row__artifacts">
      {%- if row.code %}{{ row.code }} code{% endif %}
      {%- if row.code and row.data %}, {% endif %}
      {%- if row.data %}{{ row.data }} data{% endif %}
    </span>
    {#- The note wraps onto its own line and only exists when there is
        something to say. A backfilled day says so; a day whose live run
        withheld it says that too, and a day that is both says both — the
        record and the issue disagreeing in silence is the thing this
        prevents (0Y, Y1-2). -#}
    {%- if row.backfilled or row.withheld %}
    <span class="uc-row__note">
      {%- if row.backfilled %}Assembled later: nobody was watching on {{ row.date }}, so this issue was built from the archived candidates afterwards.{% endif %}
      {%- if row.withheld %}{% if row.backfilled %} {% endif %}That morning's live run published nothing — {{ row.withheld }}.{% endif %}
    </span>
    {%- endif %}
  </li>
  {% endfor %}
</ul>
