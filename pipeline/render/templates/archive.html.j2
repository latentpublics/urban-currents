{#- Archive. Same row grammar as the home strip, one page per month.

    Mockup 6b draws month tabs. **Built as real pages rather than tabs over one
    long list**, for three reasons:

      * No JavaScript, which was the requirement. Anchors would also satisfy
        that, but they would put all 62 issues — soon several hundred — in one
        document, which is the opposite of what a tab is for.
      * A month is a URL. `archive/2026-08.html` can be linked, bookmarked and
        fed to a crawler; `archive.html#2026-08` is one page pretending.
      * The row grammar is shared with the home strip through the same include,
        so the two cannot drift.

    `archive.html` is the landing page and shows the newest month. Every tab is
    an `<a>` that actually goes somewhere. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Urban Currents — Archive{% if month %} — {{ month.label }}{% endif %}</title>
{{ head_extras }}
<style>
{{ css }}
</style>
</head>
<body>
<main class="uc-page">
  {#- One list, from `site.nav_links` — the issue pages inject the same one
      (0Z, Z4). Two renderers is deliberate; two link lists was drift. -#}
  <nav class="uc-nav">
    {%- for link in nav %}
    <a{% if link.cls %} class="{{ link.cls }}"{% endif %} href="{{ link.href }}">{{ link.label }}</a>
    {%- endfor %}
    <span class="uc-nav__lang">EN</span>
  </nav>

  <header class="uc-archive__masthead">
    <h1 class="uc-archive__h1">Archive</h1>
    <p class="uc-archive__summary">
      {{ stats.published_days }} issues since {{ stats.first_month }} ·
      {{ stats.total_published }} papers published ·
      {{ stats.quiet_days }} quiet day{{ 's' if stats.quiet_days != 1 }}
      {%- if stats.missing_days %} · {{ stats.missing_days }} day{{ 's' if stats.missing_days != 1 }} we could not see{% endif %}.
      Quiet days are kept: each still reviews what appeared. A day we could not
      see is marked as that, and never as a quiet one.
    </p>
  </header>

  {#- The tabs. The current month is a `span`, not a link to itself — a tab that
      navigates to the page you are on is a dead control that looks live. -#}
  <nav class="uc-tabs" aria-label="Archive by month">
    {% for tab in tabs %}
    {% if tab.current %}
    <span class="uc-tabs__tab uc-tabs__tab--current" aria-current="page">{{ tab.short }}</span>
    {% else %}
    <a class="uc-tabs__tab" href="{{ tab.href }}">{{ tab.short }}</a>
    {% endif %}
    {% endfor %}
  </nav>

  {% if month %}
  <section class="uc-month">
    <h2 class="uc-month__label">
      {{ month.label }} — {{ month.published }} issue{{ 's' if month.published != 1 }}
      {%- if month.quiet %} · {{ month.quiet }} quiet{% endif %}
      {%- if month.missing %} · {{ month.missing }} not seen{% endif %}
    </h2>
    {% with rows = month.rows, issue_href = root + "issues/" %}{% include "_archive_rows.html.j2" %}{% endwith %}
  </section>
  {% endif %}

  <footer class="uc-footer">
    <p class="uc-footer__ilp">Institute for Latent Publics · free, no ads, no metrics</p>
    <p class="uc-footer__build">urban-currents {{ pipeline_version }}</p>
    {# arXiv's terms require this wording exactly, including the disclaimer. #}
    <p class="uc-attribution">
      Thank you to arXiv for use of its open access interoperability. This
      service was not reviewed or approved by, nor does it necessarily express
      or reflect the policies or opinions of, arXiv.
    </p>
  </footer>
</main>
</body>
</html>
