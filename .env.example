# OpenAlex API key. Free key from https://openalex.org/settings/api
# NOTE the variable name: OPENALEX_KEY (not OPENALEX_API_KEY).
# A free key raises the daily budget to $1/day; without a key the budget is $0.
OPENALEX_KEY=

# Google API key used by the summarize stage. **This is the one the pipeline
# actually uses**: `llm.provider` is `gemini` (config/pipeline.yaml). Without
# it the summarize stage reports SKIPPED on every run, which since 0U means the
# day is not published at all rather than published with empty cards.
GOOGLE_API_KEY=

# Anthropic API key. Only needed if `llm.provider` is switched to `anthropic`.
ANTHROPIC_API_KEY=

# Optional. Springer Nature key for the abstract enrichment stage (register at
# dev.springernature.com). Absent is a normal state: `enrich.springer` records
# SKIPPED and the run continues.
SPRINGER_API_KEY=

# Where a failed day's alert goes, and where the preview issue goes. Both are
# plain addresses. Neither reaches anyone while `deliver.backend` is `file` —
# `uc status` says so in as many words.
UC_ALERT_RECIPIENT=
UC_PREVIEW_RECIPIENT=

# SMTP credentials, used only when `deliver.backend` is `smtp`. The host and
# port live in config/pipeline.yaml under `deliver.smtp`; only the secrets are
# here.
UC_SMTP_USER=
UC_SMTP_PASSWORD=

# Contact address embedded in the arXiv User-Agent header (arXiv asks for one).
CONTACT_EMAIL=you@example.com

# Optional. A GitHub personal access token raises the search rate limit from 60
# requests an hour to 5,000. **Nothing here creates one**, and every path that
# uses it skips cleanly when it is absent — see `scripts/repo_backlink_probe.py`.
# Read-only `public_repo` scope is enough; the searches only read public data.
GITHUB_TOKEN=
