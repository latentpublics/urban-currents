.env
.venv/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Working prompts are byproducts, but the reports and the decision log are not:
# they are the only record of why the code is the way it is.
prompts/*
!prompts/reports/

# Run artifacts: raw API responses, metrics, previews. Regenerable, often large.
# Labels are the exception — a human made them and they cannot be regenerated.
runs/*
!runs/labels/
runs/labels/*_pool.jsonl

# Trained models are build outputs; the training metadata JSON is committed.
models/*.joblib

# Local embedding cache
.cache/
