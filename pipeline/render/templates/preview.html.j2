{#- Single-file daily preview. No external requests of any kind, and no
    figures or images from the papers by any route (PRD §5.7). -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Urban Currents — {{ issue.date }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<main class="uc-issue" data-date="{{ issue.date }}" data-run-id="{{ issue.run_id }}">
  <header class="uc-issue__masthead">
    <h1 class="uc-issue__title">Urban Currents</h1>
    <p class="uc-issue__date">{{ issue.date }}</p>
  </header>

  {#- Scope, then verdict. `candidates_after_gate` is still recorded and still
      in the report; it is off the screen because "through the gate" is our
      internal vocabulary and a reader cannot act on it. -#}
  <p class="uc-scanmeta">
    {{ scan_meta.arxiv_categories }} arXiv categories<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.journals }} journals<span class="uc-scanmeta__sep">·</span>
    {{ scan_meta.candidates_scanned }} candidates —
    <strong class="uc-scanmeta__verdict">{{ scan_meta.items_published }} worth your time</strong>
    {%- if scan_meta.unreadable_count %}<span class="uc-scanmeta__sep">·</span>
    <span class="uc-scanmeta__unreadable">{{ scan_meta.unreadable_count }} without an open abstract</span>
    {%- endif %}
  </p>

  <section class="uc-headline{% if issue.quiet_day %} uc-headline--quiet{% endif %}">
    <p class="uc-headline__label">{% if issue.quiet_day %}No headline{% else %}Headline{% endif %}</p>
    <p class="uc-headline__line">
      {%- if issue.quiet_day -%}
      a quiet day in urban data science
      {%- else -%}
      {{ issue.headline.line }}
      {%- endif -%}
    </p>
  </section>

{#- "Today, together" (phase 0j W3-2). Fact rows first, paragraph last: the
    rows are measurements and the paragraph is a reading of them, so the reading
    comes after the thing being read.

    A row is present only when its measurement was possible. When it was
    possible and found nothing, it says so — that is an instrument reading zero,
    not prose about absence. Below a seven-day baseline the tag row is absent
    rather than zero, and with no reference lists the canon and coupling rows
    are absent rather than zero.

    The paragraph is often missing and the box has to look deliberate without
    it. That is why the label column and the rows carry the design and the
    paragraph is a closing note rather than the header. -#}
  {% if synthesis and synthesis.has_content %}
  <section class="uc-synthesis">
    <h2 class="uc-synthesis__title">Today, together</h2>

    <dl class="uc-synthesis__facts">
      {% for row in synthesis.rows %}
      {% if row.measurable and (row.entries or row.empty_text) %}
      <div class="uc-synthesis__row" data-row="{{ row.label }}">
        <dt class="uc-synthesis__label">{{ row.label }}</dt>
        <dd class="uc-synthesis__value">
          {% if not row.entries %}<span class="uc-synthesis__zero">{{ row.empty_text }}</span>
          {% elif row.label == "tag shift" %}
            {% for d in row.entries %}{{ d.label }} on {{ d.today }} items, against a
            {{ d.window_days }}-day average of {{ d.baseline }}{% if not loop.last %}; {% endif %}{% endfor %}
          {% elif row.label == "canon" %}
            {% for a in row.entries %}{{ a.count }} item{{ 's' if a.count != 1 }} cite
            <span class="uc-synthesis__work">{{ a.title }}</span>{% if a.cite %} ({{ a.cite }}){% endif %}
            {%- if a.note %}, {{ a.note }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}
          {% elif row.label == "coupling" %}
            {% for c in row.entries %}
            <span class="uc-synthesis__work">{{ c.titles[0] }}</span> shares
            {{ c.shared }} references with <span class="uc-synthesis__work">{{ c.titles[1] }}</span>
            {%- if c.partner_date %} ({{ c.partner_date }}){% endif %}
            {%- if c.shared_titles %}
            {#- <details> so the shared works fold away, and the summary carries
                the count so a client that cannot open it still says something
                true. Mail clients that ignore <details> render the contents
                inline, which is the intended failure. -#}
            <details class="uc-synthesis__shared">
              <summary>{{ c.shared_titles|length }} of them</summary>
              <ul>{% for t in c.shared_titles %}<li>{{ t }}</li>{% endfor %}</ul>
            </details>
            {%- endif %}{% if not loop.last %}; {% endif %}
            {% endfor %}
          {% elif row.label == "institutions" %}
            {% for i in row.entries %}{{ i.name }} on {{ i.papers }}
            {{- ' papers today' if i.scope == 'today' else ' papers in ' ~ synthesis.window_days ~ ' days' }}
            {%- if not loop.last %}; {% endif %}{% endfor %}
          {% else %}
            {% for a in row.entries %}{{ a.name }} on {{ a.papers }} of today's papers
            {%- if not loop.last %}; {% endif %}{% endfor %}
          {% endif %}
        </dd>
      </div>
      {% endif %}
      {% endfor %}

      {% if synthesis.first_internal_citation %}
      <div class="uc-synthesis__row" data-row="first-internal">
        <dt class="uc-synthesis__label">first</dt>
        <dd class="uc-synthesis__value">
          Today is the first time a paper in this digest cites another paper from it.
        </dd>
      </div>
      {% endif %}
    </dl>

    {% if synthesis.paragraph %}
    <p class="uc-synthesis__paragraph">{{ synthesis.paragraph }}</p>
    {% else %}
    <!-- paragraph omitted: {{ synthesis.omitted_reason }} -->
    {% endif %}
  </section>
  {% endif %}

  <div class="uc-cards">
    {% for card in cards %}{% include "item_card.html.j2" %}{% endfor %}
  </div>

  {#- The canon card, **after the items** (0S, U1).

      It was above them, which put "what this field stands on" in front of what
      the field did today. Mockup 6a and 7a both place it between the cards and
      `Also published today`, and the reason is the reading order: the day's
      work is the issue, and the foundation it leans on is a footnote to that,
      not a preface to it.

      Absent entirely on a day that cites no foundational work — see
      `build_still_cited`. -#}
  {% if still_cited %}
  <section class="uc-canon">
    <h2 class="uc-canon__title">Still cited</h2>
    <div class="uc-canon__box">
      <p class="uc-canon__work">
        {% if still_cited.citation %}{{ still_cited.citation }}, {% endif %}
        <span class="uc-canon__name">{{ still_cited.title }}</span>
        <span class="uc-canon__counts">
          {{ still_cited.cited_today }} of today's items cite it ·
          {{ still_cited.archive_citations }} of {{ still_cited.archive_total }} in the archive stand on it
        </span>
      </p>
    </div>
  </section>
  {% endif %}

  {% if unreadable %}
  {#- `Also published today`. Facts only: no sentence here was generated,
      because these items have no abstract to generate one from.

      Two lines, per the mockup — title, then everything else in faint ink. The
      mockup drops the authors; they are kept, because the instruction that
      created this section was "title, authors, whatever is available", and a
      record with no abstract is exactly where a byline does the most work. -#}
  <section class="uc-also">
    <h2 class="uc-also__title">Also published today</h2>
    <p class="uc-also__note">
      These appeared today in journals we track. Their abstracts are not openly
      available, so we cannot summarise them.
    </p>
    <ul class="uc-also__list">
      {% for row in unreadable %}
      <li class="uc-also__item" data-work-key="{{ row.work_key }}">
        <span class="uc-also__item-title">
          {% if row.url %}<a href="{{ row.url }}" rel="noopener">{{ row.title }}</a>
          {% else %}{{ row.title }}{% endif %}
        </span>
        <span class="uc-also__byline">
          {{ row.authors }}
          {%- if row.affiliation %}<span class="uc-also__sep"> · </span>{{ row.affiliation }}{% endif %}
          {%- if row.journal %}<span class="uc-also__sep"> · </span>{{ row.journal }}{% endif %}
          {%- for t in row.title_terms %}<span class="uc-also__sep"> · </span><span class="uc-tag uc-tag--from-title">{{ t }}</span>{% endfor %}
        </span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if status_changes %}
  <section class="uc-status-changes">
    <p class="uc-status-changes__title">Status changes</p>
    <ul>
      {% for change in status_changes %}
      <li data-work-key="{{ change.work_key }}">{{ change.text }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer class="uc-footer">
    <p class="uc-footer__ilp">Institute for Latent Publics · free, no ads, no metrics</p>
    <p class="uc-footer__build">Generated by urban-currents {{ pipeline_version }} · run {{ issue.run_id }}</p>
    {# arXiv's API terms of use and brand guidelines require this wording
       exactly, including the disclaimer. It must not be paraphrased, and
       nothing here may suggest arXiv endorses or reviewed this service. #}
    <p class="uc-attribution">
      Thank you to arXiv for use of its open access interoperability. This
      service was not reviewed or approved by, nor does it necessarily express
      or reflect the policies or opinions of, arXiv.
    </p>
  </footer>
</main>
</body>
</html>
