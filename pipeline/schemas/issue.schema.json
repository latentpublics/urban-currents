      "type": "object"
    },
    "SynthesisName": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "papers": {
          "title": "Papers",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "papers"
      ],
      "title": "SynthesisName",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One daily edition. Immutable once published.\n\n**`date` means the day we published, not the day the papers did** (phase 0k,\nX1). OpenAlex indexes a journal article a median of 1 day and a p90 of 2 days\nafter its publication date, and no arXiv item has ever been visible to us on\nits own publication day. An issue dated by publication would therefore have\nto wait for the slow tail or silently omit it, and \"today's papers\" would be\na claim we cannot keep.\n\nSo an issue covers the window it drew from, and `covers_from` / `covers_to`\nrecord it. Each card carries its own publication date.",
  "properties": {
    "covers_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Covers From"
    },
    "covers_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Covers To"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "headline": {
      "$ref": "#/$defs/Headline"
    },
    "items": {
      "items": {
        "type": "string"
      },
      "title": "Items",
      "type": "array"
    },
    "quiet_day": {
      "default": false,
      "title": "Quiet Day",
      "type": "boolean"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "scan_meta": {
      "$ref": "#/$defs/ScanMeta"
    },
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status_changes": {
      "items": {
        "$ref": "#/$defs/StatusChange"
      },
      "title": "Status Changes",
      "type": "array"
    },
    "synthesis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Synthesis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unreadable": {
      "items": {
        "type": "string"
      },
      "title": "Unreadable",
      "type": "array"
    }
  },
  "required": [
    "date"
  ],
  "title": "Issue",
  "type": "object"
}
