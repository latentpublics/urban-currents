  "summary": {
    "en": {
      "caveats": "The study relies on remote sensing proxies rather than direct ground-level economic and land transaction data.",
      "what": "Using spatial difference-in-differences on satellite-derived night-time light and vegetation index data, this study measures the impact of Bangkok's Purple Line rail transit on surrounding areas. The rail expansion significantly boosted local economic activity and generated positive spatial spillovers, particularly in initially underdeveloped locations, but led to slower physical land development near station nodes compared to distant control sites.",
      "why": "It challenges the assumption that transit accessibility automatically triggers physical land conversion, demonstrating that economic intensification and land development can decouple when land market constraints or regulatory hurdles exist."
    }
  },
