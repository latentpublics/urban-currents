          "type": "integer"
        },
        "citing_work_keys": {
          "items": {
            "type": "string"
          },
          "title": "Citing Work Keys",
          "type": "array"
        },
        "days_since_last_cited": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days Since Last Cited"
        },
        "first_in_window": {
          "default": false,
          "title": "First In Window",
          "type": "boolean"
        },
        "openalex_id": {
          "title": "Openalex Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "openalex_id",
        "title"
      ],
      "title": "SynthesisAnchor",
      "type": "object"
    },
    "SynthesisCluster": {
      "additionalProperties": false,
      "description": "Two papers sharing references, named by the references themselves.\n\n`shared_titles` is the point: a cluster described by its shared bibliography\nhas no room for an invented theme.",
      "properties": {
        "partner_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partner Date"
        },
        "scope": {
          "enum": [
            "today",
            "archive"
          ],
          "title": "Scope",
          "type": "string"
        },
        "shared": {
          "default": 0,
          "title": "Shared",
          "type": "integer"
        },
        "shared_titles": {
          "items": {
            "type": "string"
          },
          "title": "Shared Titles",
          "type": "array"
        },
        "titles": {
          "items": {
            "type": "string"
          },
          "title": "Titles",
          "type": "array"
        },
        "work_keys": {
          "items": {
            "type": "string"
          },
          "title": "Work Keys",
          "type": "array"
        }
      },
      "required": [
        "scope"
      ],
      "title": "SynthesisCluster",
      "type": "object"
    },
    "SynthesisDeviation": {
      "additionalProperties": false,
      "properties": {
        "baseline_per_day": {
          "title": "Baseline Per Day",
