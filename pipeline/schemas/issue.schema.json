    "Synthesis": {
      "additionalProperties": false,
      "description": "How today connects to what came before (PRD \u00a75.7, phase 0i).\n\nEverything except `paragraph` is measured. `paragraph` is written by an LLM\nfrom those measurements and nothing else, and is absent on days with no\nmeasured link \u2014 which is a correct outcome, not a missing field.",
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/SynthesisAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "clusters": {
          "items": {
            "$ref": "#/$defs/SynthesisCluster"
          },
          "title": "Clusters",
          "type": "array"
        },
        "composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Composition",
          "type": "object"
        },
        "deviation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviation Note"
        },
        "deviation_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviation Status"
        },
        "deviations": {
          "items": {
            "$ref": "#/$defs/SynthesisDeviation"
          },
          "title": "Deviations",
          "type": "array"
        },
        "first_internal_citation": {
          "default": false,
          "title": "First Internal Citation",
          "type": "boolean"
        },
        "institutions_in_window": {
          "items": {
            "$ref": "#/$defs/SynthesisName"
          },
          "title": "Institutions In Window",
          "type": "array"
        },
        "institutions_today": {
          "items": {
            "$ref": "#/$defs/SynthesisName"
          },
          "title": "Institutions Today",
          "type": "array"
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "paragraph_omitted_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Omitted Reason"
        },
        "repeat_authors": {
          "items": {
            "$ref": "#/$defs/SynthesisName"
          },
          "title": "Repeat Authors",
          "type": "array"
        },
        "window_days": {
          "default": 30,
          "title": "Window Days",
          "type": "integer"
        }
      },
      "title": "Synthesis",
      "type": "object"
    },
    "SynthesisAnchor": {
      "additionalProperties": false,
      "description": "A foundation-canon work today's papers stand on.",
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
