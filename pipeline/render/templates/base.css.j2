/* Inlined into preview.html. No external requests, no webfonts, no images.
   Phase 1's Astro components take these class names over verbatim, so renaming
   anything here is a cross-phase change, not a cosmetic one.

   Phase 0j extended this rather than replacing it: the mockups were built on
   these values, so #16181d, #555a63, #e3e5ea and #1f5fa8 were already here.

   THE INK SCALE IS MEASURED, NOT PICKED. Every value below clears WCAG AA for
   body text (4.5:1) against every background it is used on, in both modes. The
   mockup's faintest ink (#9296a0) measures 2.91:1 on paper — below AA, and it
   is the caveat colour, which is body-size text a reader has to be able to
   read. It was darkened to #686d78 (5.10:1). The hierarchy the mockup asked
   for — "three inks, three sizes; hierarchy is weight and colour, not boxes" —
   survives, because the steps are 17.45 / 6.81 / 5.84 / 5.10 and each is
   visibly lighter than the last. */

:root {
  --uc-ink: #16181d;
  --uc-ink-soft: #555a63;
  /* Meta rail, section labels. */
  --uc-meta: #5f646d;
  /* The faintest ink there is. Caveats, secondary rows. */
  --uc-faint: #686d78;
  --uc-line: #e3e5ea;
  /* Row separators — lighter than --uc-line, structural only, never carries text. */
  --uc-hairline: #eef0f2;
  --uc-bg: #fdfdfc;
  --uc-bg-soft: #f5f6f4;
  --uc-accent: #1f5fa8;
  /* Blue badge: an artifact exists (code, data, published). */
  --uc-badge-bg: #eef2f8;
  /* Grey chip: a state (preprint, a quiet day). */
  --uc-chip-bg: #f0f1f3;
  --uc-quiet: #5f646d;

  /* Font stacks only — no font is ever fetched, and the rule that forbids it
     is checked by grepping the rendered HTML, so this comment deliberately
     does not spell the at-rule out. A reader who has these sees them; everyone else
     falls to Georgia, which is the mockup's own stated email fallback, and the
     request cost is zero bytes either way. Korean faces are appended rather
     than fronted: /ko/ is phase 1, but the stack is settled now so the two
     languages cannot drift into two type systems.

     Hangul carries almost no serif/sans distinction at screen sizes, so a
     Korean reader will see headings and body in the same face. That is correct
     rather than a degradation — the hierarchy is carried by size and weight,
     which is what the mockup asked for in the first place. */
  --uc-font-serif: "Source Serif 4", "Source Serif Pro", Georgia, "Times New Roman",
                   Pretendard, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", serif;
  --uc-font-sans: "Public Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                  Helvetica, Arial, Pretendard, "Apple SD Gothic Neo", "Malgun Gothic",
                  "Noto Sans KR", sans-serif;
  /* IBM Plex Mono was named in the mockup and missing from this stack, so
     every figure fell to the system mono. It is vendored for the site
     (T1) and still degrades to the system faces everywhere else. */
  --uc-font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo,
                  Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  /* The mockups have no dark pass — it is in turn 7's "try next" list — so
     these are chosen here and measured the same way. Same rule: every ink
     clears 4.5:1 on every ground it appears on. The two new surfaces are lifted
     off the page background by about the same amount as in light mode, which is
     what keeps the synthesis box reading as a box without a border. */
  :root {
    --uc-ink: #e8eaee;
    --uc-ink-soft: #a3a9b4;
    --uc-meta: #959ca8;
    --uc-faint: #949ba7;
    --uc-line: #2c3038;
    --uc-hairline: #23272e;
    --uc-bg: #14161a;
    --uc-bg-soft: #1b1e24;
    --uc-accent: #7fb0e8;
    --uc-badge-bg: #232830;
    --uc-chip-bg: #262a31;
    --uc-quiet: #8b919c;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 2rem 1rem 4rem;
  background: var(--uc-bg);
  color: var(--uc-ink);
  font: 16px/1.6 var(--uc-font-sans);
}

.uc-issue { max-width: 46rem; margin: 0 auto; }

.uc-issue__masthead {
  border-bottom: 2px solid var(--uc-ink);
  padding-bottom: 0.75rem;
  margin-bottom: 1.5rem;
}
.uc-issue__title { font-size: 1.5rem; font-weight: 700; margin: 0; letter-spacing: -0.01em; }
.uc-issue__date { color: var(--uc-ink-soft); font-size: 0.95rem; margin: 0.25rem 0 0; }

.uc-scanmeta {
  font-size: 0.82rem;
  color: var(--uc-ink-soft);
  margin: 0 0 2rem;
  font-variant-numeric: tabular-nums;
}
.uc-scanmeta__sep { margin: 0 0.4rem; opacity: 0.5; }

.uc-headline {
  background: var(--uc-bg-soft);
  border-left: 3px solid var(--uc-accent);
  padding: 1rem 1.25rem;
  margin-bottom: 2.5rem;
}
.uc-headline__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.35rem;
}
.uc-headline__line { font-size: 1.12rem; font-weight: 600; margin: 0; line-height: 1.45; }
.uc-headline--quiet .uc-headline__line { font-weight: 400; color: var(--uc-quiet); font-style: italic; }

.uc-cards { display: flex; flex-direction: column; gap: 0; }

/* Two columns from flex, and the fallback is the point: a client that does not
   implement flex lays both children out as blocks, which stacks the meta rail
   above the body — the same shape as the mobile layout. Outlook gets the
   phone's design for free and there is no second template to maintain. */
.uc-card {
  display: flex;
  gap: 1.5rem;
  border-top: 1px solid var(--uc-line);
  padding: 1.25rem 0;
}

.uc-card__meta {
  width: 190px;
  flex: 0 0 190px;
  border-right: 1px solid var(--uc-hairline);
  padding-right: 1.25rem;
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--uc-meta);
}
.uc-card__badges { margin: 0 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
.uc-card__byline { margin: 0 0 0.5rem; color: var(--uc-meta); }
.uc-card__was { color: var(--uc-faint); }
.uc-card__facets { margin: 0; color: var(--uc-faint); }
.uc-card__facets .uc-tag { color: var(--uc-meta); }
.uc-tag__sep { color: var(--uc-faint); }

.uc-card__body { flex: 1 1 auto; min-width: 0; }
.uc-card__title {
  font-family: var(--uc-font-serif);
  font-size: 1.12rem;
  font-weight: 650;
  margin: 0 0 0.45rem;
  line-height: 1.35;
  letter-spacing: -0.01em;
}
.uc-card__title a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--uc-line); }
.uc-card__title a:hover { border-bottom-color: var(--uc-accent); }

/* Three inks, three sizes. The hierarchy is weight and colour, not boxes. */
.uc-card__what { margin: 0 0 0.5rem; }
.uc-card__why { margin: 0 0 0.5rem; color: var(--uc-ink-soft); }
.uc-card__why-lead { font-style: normal; font-weight: 650; color: var(--uc-ink); }
.uc-card__caveats { margin: 0 0 0.5rem; font-size: 0.92rem; color: var(--uc-faint); }
.uc-card__pending {
  margin: 0 0 0.5rem;
  font-size: 0.92rem;
  color: var(--uc-faint);
  font-style: italic;
}

.uc-badge {
  display: inline-block;
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.15rem 0.4rem;
  border-radius: 2px;
}
/* Blue says an artifact exists; grey says a state. */
.uc-badge--artifact { background: var(--uc-badge-bg); color: var(--uc-accent); }
.uc-badge--state { background: var(--uc-chip-bg); color: var(--uc-meta); }

.uc-card__links { font-size: 0.82rem; margin: 0.5rem 0 0; }
.uc-card__links a { color: var(--uc-accent); text-decoration: none; }
.uc-card__links a:hover { text-decoration: underline; }
.uc-card__link-sep { color: var(--uc-faint); }

/* 640px, because that is where the 190px rail plus a readable measure stops
   fitting: below it the body column falls under about 45 characters, which is
   where line breaks start landing mid-phrase. The rail folds to the top of the
   card and its rule disappears — the same shape flex-less clients already get. */
@media (max-width: 640px) {
  .uc-card { flex-direction: column; gap: 0.5rem; }
  .uc-card__meta {
    width: auto;
    flex: none;
    border-right: 0;
    padding-right: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .uc-card__facets { font-style: italic; width: 100%; }
}

.uc-status-changes { margin-top: 3rem; border-top: 1px solid var(--uc-line); padding-top: 1rem; }
.uc-status-changes__title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.5rem;
}
.uc-status-changes ul { margin: 0; padding-left: 1.1rem; font-size: 0.88rem; color: var(--uc-ink-soft); }

.uc-footer {
  margin-top: 3rem;
  padding-top: 1rem;
  border-top: 1px solid var(--uc-line);
  font-size: 0.75rem;
  color: var(--uc-quiet);
}

/* `Also published today` — deliberately low-weight. These are records we could
   not read, so the section must not compete with the cards for attention; it
   sits after them, smaller, in the soft ink. */
.uc-also {
  margin-top: 3rem;
  border-top: 1px solid var(--uc-line);
  padding-top: 1rem;
}
.uc-also__title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.4rem;
}
.uc-also__note {
  font-size: 0.82rem;
  color: var(--uc-quiet);
  margin: 0 0 0.9rem;
  max-width: 46rem;
}
.uc-also__list { list-style: none; padding: 0; margin: 0; }
.uc-also__item {
  font-size: 0.88rem;
  padding: 0.45rem 0;
  border-bottom: 1px solid var(--uc-line);
}
.uc-also__item:last-child { border-bottom: 0; }
.uc-also__item-title { display: block; color: var(--uc-ink); }
.uc-also__item-title a { color: var(--uc-ink); text-decoration: none; }
.uc-also__item-title a:hover { text-decoration: underline; }
.uc-also__byline {
  display: block;
  font-size: 0.78rem;
  color: var(--uc-ink-soft);
  margin-top: 0.15rem;
}
.uc-also__sep { padding: 0 0.35rem; color: var(--uc-quiet); }
.uc-also__tags { display: block; font-size: 0.75rem; margin-top: 0.2rem; }
.uc-tag--topic { color: var(--uc-ink-soft); }
/* Matched against the title alone, so it is shown as weaker evidence than a
   tag drawn from a full record. */
.uc-tag--from-title { color: var(--uc-quiet); font-style: italic; }

.uc-scanmeta__unreadable { color: var(--uc-quiet); }

.uc-attribution {
  margin-top: 0.8rem;
  font-size: 0.72rem;
  color: var(--uc-quiet);
  max-width: 46rem;
}

/* "Today, together" (phase 0j). Block flow only — this has to hold together in
   an email client, where floats, grids and flex are unreliable. No colour
   carries meaning; the section is legible as plain text.

   The paragraph is absent more often than not, so the box is designed around
   the rows: a fixed label column gives it structure whether or not the closing
   sentence exists. */
.uc-synthesis {
  background: var(--uc-bg-soft);
  padding: 1rem 1.25rem;
  margin: 1.5rem 0 2rem;
}
.uc-synthesis__title {
  margin: 0 0 0.75rem;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}
.uc-synthesis__facts { margin: 0; }
.uc-synthesis__row {
  display: flex;
  gap: 0.75rem;
  padding: 0.3rem 0;
  border-top: 1px solid var(--uc-hairline);
  font-size: 0.92rem;
  line-height: 1.55;
}
.uc-synthesis__row:first-child { border-top: 0; }
.uc-synthesis__label {
  width: 88px;
  flex: 0 0 88px;
  color: var(--uc-meta);
  font-size: 0.78rem;
  line-height: 1.9;
}
.uc-synthesis__value { margin: 0; flex: 1 1 auto; min-width: 0; }
.uc-synthesis__work { font-style: italic; }
/* A measured zero is stated in the same ink as a measured something. It is not
   an error state and must not look like one. */
.uc-synthesis__zero { color: var(--uc-meta); }
.uc-synthesis__shared { display: inline; }
.uc-synthesis__shared > summary {
  display: inline;
  cursor: pointer;
  color: var(--uc-meta);
  font-size: 0.85rem;
}
.uc-synthesis__shared ul {
  margin: 0.25rem 0 0.25rem 1rem;
  padding: 0;
  font-size: 0.85rem;
  color: var(--uc-faint);
}
.uc-synthesis__paragraph {
  margin: 0.9rem 0 0;
  padding-top: 0.75rem;
  border-top: 1px solid var(--uc-hairline);
  line-height: 1.6;
}

@media (max-width: 640px) {
  .uc-synthesis__row { flex-direction: column; gap: 0.1rem; padding: 0.45rem 0; }
  .uc-synthesis__label { width: auto; flex: none; line-height: 1.4; }
}

/* `Also published today` — two lines: title, then everything we do have in the
   faintest ink. Nothing in this section was written by a model. */
.uc-also { margin: 2rem 0 0; border-top: 1px solid var(--uc-line); padding-top: 1rem; }
.uc-also__title {
  margin: 0 0 0.25rem;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}
.uc-also__note { margin: 0 0 0.75rem; font-size: 0.85rem; color: var(--uc-faint); }
.uc-also__list { list-style: none; padding: 0; margin: 0; }
.uc-also__item { padding: 0.4rem 0; border-top: 1px solid var(--uc-hairline); }
.uc-also__item:first-child { border-top: 0; }
.uc-also__item-title { display: block; font-size: 0.95rem; line-height: 1.4; }
.uc-also__item-title a { color: var(--uc-ink); text-decoration: none; }
.uc-also__item-title a:hover { text-decoration: underline; }
.uc-also__byline { display: block; font-size: 0.8rem; color: var(--uc-faint); margin-top: 0.1rem; }
.uc-also__sep { opacity: 0.6; }
.uc-tag--from-title { font-style: italic; }

.uc-footer__ilp { margin: 0 0 0.25rem; color: var(--uc-meta); }
.uc-footer__build { margin: 0 0 0.5rem; }

/* ---- Site chrome: home and archive (phase 0j W4) ---------------------- */

.uc-page { max-width: 46rem; margin: 0 auto; }

.uc-nav {
  display: flex;
  align-items: baseline;
  gap: 0.9rem;
  padding: 0 0 0.75rem;
  border-bottom: 1px solid var(--uc-line);
  font-size: 0.82rem;
}
.uc-nav__brand { font-weight: 700; font-size: 0.95rem; }
.uc-nav a { color: var(--uc-meta); text-decoration: none; }
.uc-nav a:hover { color: var(--uc-ink); }
.uc-nav__lang { margin-left: auto; color: var(--uc-meta); font-size: 0.75rem; }

.uc-mission { padding: 1.75rem 0 2rem; }
.uc-mission__title {
  font-family: var(--uc-font-serif);
  font-size: 1.6rem;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
  margin: 0;
}
.uc-mission__lede { font-size: 0.95rem; color: var(--uc-ink-soft); margin: 0.75rem 0 0; line-height: 1.65; }

.uc-latest { border-top: 2px solid var(--uc-ink); padding-top: 0.9rem; margin-bottom: 2rem; }
.uc-latest__head, .uc-archive__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}
.uc-latest__title, .uc-archive__title {
  margin: 0;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}
.uc-latest__date, .uc-archive__all { font-size: 0.8rem; color: var(--uc-meta); text-decoration: none; }
.uc-latest__lead {
  font-family: var(--uc-font-serif);
  font-size: 1.05rem;
  line-height: 1.5;
  margin: 0 0 0.9rem;
}
/* Mockup 5a: lead on the left, a 210px stat rail on the right, a hairline
   between. Flex rather than grid because the only thing 7b changes is the
   direction, and `flex-direction: column` is the whole mobile story. */
.uc-latest__cols { display: flex; gap: 2rem; margin: 1rem 0 0; }
.uc-latest__lede { flex: 1; min-width: 0; }
.uc-latest__note { font-size: 0.85rem; color: var(--uc-ink-soft); margin: 0.65rem 0 0; line-height: 1.6; }
.uc-latest__read { font-size: 0.8rem; color: var(--uc-accent); text-decoration: none; }
.uc-latest__stats {
  flex: 0 0 210px;
  border-left: 1px solid var(--uc-line);
  padding-left: 1.5rem;
  margin: 0;
  font-size: 0.8rem;
  font-variant-numeric: tabular-nums;
}
.uc-latest__stats div { display: flex; justify-content: space-between; gap: 0.75rem; line-height: 2; }
.uc-latest__stats dt { color: var(--uc-meta); }
.uc-latest__stats dd { margin: 0; font-weight: 600; }
.uc-latest__accent { color: var(--uc-accent); }
.uc-latest__quiet { color: var(--uc-faint); font-weight: 400; }

/* The 14-day strip. `align-items: flex-end` so bars grow from the baseline,
   and each slot is a full-height flex column so a short bar still occupies its
   share of the width — 14 slots, always, including the days we could not see. */
.uc-spark { display: flex; gap: 6px; align-items: flex-end; height: 56px; margin: 0 0 0.4rem; }
.uc-spark__slot { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
.uc-spark__bar--published { background: var(--uc-accent); }
.uc-spark__bar--today { background: var(--uc-ink); }
.uc-spark__bar--quiet { background: var(--uc-line); }
/* A day nobody could see is not a quiet day. Same weight on the page, a
   different mark: hatched rather than solid, so the two are distinguishable
   without colour and without reading the label. */
.uc-spark__bar--missing {
  background: repeating-linear-gradient(
    45deg, var(--uc-line), var(--uc-line) 2px, transparent 2px, transparent 4px);
  border: 1px solid var(--uc-line);
}
.uc-spark__caption {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  font-size: 0.7rem;
  color: var(--uc-faint);
  margin: 0 0 1.25rem;
  font-variant-numeric: tabular-nums;
}
/* Available to a screen reader, absent from the visual layer. The bars carry
   their meaning in colour and height; this is the same meaning in words. */
.uc-visually-hidden {
  position: absolute;
  width: 1px; height: 1px;
  margin: -1px; padding: 0; border: 0;
  clip-path: inset(50%);
  overflow: hidden;
  white-space: nowrap;
}

.uc-archive { border-top: 2px solid var(--uc-ink); padding-top: 0.9rem; margin-bottom: 2.5rem; }
.uc-archive__masthead { padding: 1.75rem 0 1.25rem; }
.uc-archive__h1 { font-family: var(--uc-font-serif); font-size: 1.6rem; margin: 0; }
.uc-archive__summary { font-size: 0.9rem; color: var(--uc-ink-soft); margin: 0.5rem 0 0; }
/* Mockup 6b's month tabs. Underline rather than a filled pill: the archive is
   a list of dates, and a row of buttons would give it more furniture than the
   thing it navigates. The current tab is a span, so it has no hover and no
   pointer — it is a label, not a dead control. */
.uc-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 1.1rem;
  border-bottom: 1px solid var(--uc-line);
  margin: 0 0 1.25rem;
  padding: 0 0 0.5rem;
  font-size: 0.82rem;
}
.uc-tabs__tab { color: var(--uc-meta); text-decoration: none; padding-bottom: 0.45rem; }
.uc-tabs__tab:hover { color: var(--uc-ink); }
.uc-tabs__tab--current {
  color: var(--uc-ink);
  font-weight: 600;
  box-shadow: inset 0 -2px 0 0 var(--uc-ink);
}
.uc-month { margin-bottom: 1.75rem; }
.uc-month__label {
  margin: 0 0 0.4rem;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}

.uc-rows { list-style: none; padding: 0; margin: 0; }
.uc-row {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.4rem 0;
  border-top: 1px solid var(--uc-hairline);
  font-size: 0.85rem;
}
.uc-row:first-child { border-top: 0; }
.uc-row__date { flex: 0 0 5.5rem; color: var(--uc-meta); font-variant-numeric: tabular-nums; }
.uc-row__bar { flex: 0 0 3.5rem; height: 0.45rem; background: var(--uc-hairline); display: inline-block; }
.uc-row__fill { display: block; height: 100%; background: var(--uc-accent); }
/* A quiet day's bar is grey AND the row says "a quiet day" in words. Colour
   never carries the meaning on its own. */
.uc-row--quiet .uc-row__fill { background: var(--uc-quiet); }
.uc-row__count { flex: 0 0 5.5rem; font-variant-numeric: tabular-nums; }
.uc-row__lead {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--uc-ink);
}
.uc-row__artifacts { flex: 0 0 auto; color: var(--uc-faint); font-size: 0.78rem; }
.uc-chip {
  background: var(--uc-chip-bg);
  color: var(--uc-meta);
  border-radius: 2px;
  padding: 0.1rem 0.35rem;
  font-size: 0.75rem;
}

/* The hover detail is CSS only and purely additive: the row is complete
   without it, which is the condition for having it at all. Touch devices and
   mail clients simply never see it. */
.uc-row__lead:hover, .uc-row:focus-within .uc-row__lead {
  white-space: normal;
  overflow: visible;
}

.uc-columns { display: flex; gap: 1.75rem; border-top: 1px solid var(--uc-line); padding-top: 1.25rem; }
.uc-column { flex: 1 1 0; }
.uc-column h3 {
  margin: 0 0 0.35rem;
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}
.uc-column p { margin: 0; font-size: 0.85rem; line-height: 1.6; color: var(--uc-ink-soft); }

@media (max-width: 640px) {
  .uc-row { flex-wrap: wrap; gap: 0.25rem 0.6rem; }
  .uc-row__lead { flex: 1 1 100%; white-space: normal; }
  .uc-columns { flex-direction: column; gap: 1.25rem; }
  /* 7b: the rail stops being a rail. It drops below the lead and becomes a
     row of figures, so the left border would be a line across the top of
     nothing — it goes, and a rule above takes its place. */
  .uc-latest__cols { flex-direction: column; gap: 1.1rem; }
  .uc-latest__stats {
    flex: 1 1 auto;
    border-left: 0;
    border-top: 1px solid var(--uc-line);
    padding-left: 0;
    padding-top: 0.75rem;
  }
  .uc-spark { height: 40px; gap: 3px; }
  .uc-spark__caption span:nth-child(2) { display: none; }
  .uc-latest__stats { gap: 1.25rem; }
}

/* "Still cited" — off by default; styled so turning it on is a config change
   and not also a design job. */
.uc-canon { border-left: 3px solid var(--uc-accent); padding: 0.6rem 0 0.6rem 0.9rem; margin: 1.5rem 0; }
.uc-canon__title {
  margin: 0 0 0.3rem;
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--uc-meta);
}
.uc-canon__work { margin: 0; font-size: 0.95rem; }
.uc-canon__name { font-style: italic; }
.uc-canon__counts { margin: 0.2rem 0 0; font-size: 0.8rem; color: var(--uc-faint); }

/* A day we could not see. Deliberately not the quiet day's grey: the two are
   different claims and colour alone must not be what separates them, so the row
   also says "no issue" and prints the reason where a title would be. */
.uc-row--missing .uc-row__fill { background: transparent; }
.uc-row--missing .uc-row__bar {
  background: repeating-linear-gradient(
    45deg, var(--uc-hairline), var(--uc-hairline) 2px, transparent 2px, transparent 4px
  );
}
.uc-chip--missing { background: transparent; border: 1px solid var(--uc-line); color: var(--uc-faint); }
.uc-row__reason { color: var(--uc-faint); font-style: italic; }
