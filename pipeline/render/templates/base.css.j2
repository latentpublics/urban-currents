/* Inlined into preview.html. No external requests, no webfonts, no images.
   Phase 1's Astro components take these class names over verbatim, so renaming
   anything here is a cross-phase change, not a cosmetic one.

   Phase 0j extended this rather than replacing it: the mockups were built on
   these values, so #16181d, #555a63, #e3e5ea and #1f5fa8 were already here.

   THE INK SCALE IS MEASURED, NOT PICKED. Every value below clears WCAG AA for
   body text (4.5:1) against every background it is used on, in both modes. The
   mockup's faintest ink (#9296a0) measures 2.91:1 on paper — below AA, and it
   is the caveat colour, which is body-size text a reader has to be able to
   read. It was darkened to #686d78 (5.10:1). The hierarchy the mockup asked
   for — "three inks, three sizes; hierarchy is weight and colour, not boxes" —
   survives, because the steps are 17.45 / 6.81 / 5.84 / 5.10 and each is
   visibly lighter than the last. */

:root {
  --uc-ink: #16181d;
  --uc-ink-soft: #555a63;
  /* Meta rail, section labels. */
  --uc-meta: #5f646d;
  /* The faintest ink there is. Caveats, secondary rows. */
  --uc-faint: #686d78;
  --uc-line: #e3e5ea;
  /* Row separators — lighter than --uc-line, structural only, never carries text. */
  --uc-hairline: #eef0f2;
  --uc-bg: #fdfdfc;
  --uc-bg-soft: #f5f6f4;
  --uc-accent: #1f5fa8;
  /* Blue badge: an artifact exists (code, data, published). */
  --uc-badge-bg: #eef2f8;
  /* Grey chip: a state (preprint, a quiet day). */
  --uc-chip-bg: #f0f1f3;
  --uc-quiet: #5f646d;

  /* Font stacks only — no font is ever fetched, and the rule that forbids it
     is checked by grepping the rendered HTML, so this comment deliberately
     does not spell the at-rule out. A reader who has these sees them; everyone else
     falls to Georgia, which is the mockup's own stated email fallback, and the
     request cost is zero bytes either way. Korean faces are appended rather
     than fronted: /ko/ is phase 1, but the stack is settled now so the two
     languages cannot drift into two type systems.

     Hangul carries almost no serif/sans distinction at screen sizes, so a
     Korean reader will see headings and body in the same face. That is correct
     rather than a degradation — the hierarchy is carried by size and weight,
     which is what the mockup asked for in the first place. */
  --uc-font-serif: "Source Serif 4", "Source Serif Pro", Georgia, "Times New Roman",
                   Pretendard, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", serif;
  --uc-font-sans: "Public Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                  Helvetica, Arial, Pretendard, "Apple SD Gothic Neo", "Malgun Gothic",
                  "Noto Sans KR", sans-serif;
  --uc-font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  /* The mockups have no dark pass — it is in turn 7's "try next" list — so
     these are chosen here and measured the same way. Same rule: every ink
     clears 4.5:1 on every ground it appears on. The two new surfaces are lifted
     off the page background by about the same amount as in light mode, which is
     what keeps the synthesis box reading as a box without a border. */
  :root {
    --uc-ink: #e8eaee;
    --uc-ink-soft: #a3a9b4;
    --uc-meta: #959ca8;
    --uc-faint: #949ba7;
    --uc-line: #2c3038;
    --uc-hairline: #23272e;
    --uc-bg: #14161a;
    --uc-bg-soft: #1b1e24;
    --uc-accent: #7fb0e8;
    --uc-badge-bg: #232830;
    --uc-chip-bg: #262a31;
    --uc-quiet: #8b919c;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 2rem 1rem 4rem;
  background: var(--uc-bg);
  color: var(--uc-ink);
  font: 16px/1.6 var(--uc-font-sans);
}

.uc-issue { max-width: 46rem; margin: 0 auto; }

.uc-issue__masthead {
  border-bottom: 2px solid var(--uc-ink);
  padding-bottom: 0.75rem;
  margin-bottom: 1.5rem;
}
.uc-issue__title { font-size: 1.5rem; font-weight: 700; margin: 0; letter-spacing: -0.01em; }
.uc-issue__date { color: var(--uc-ink-soft); font-size: 0.95rem; margin: 0.25rem 0 0; }

.uc-scanmeta {
  font-size: 0.82rem;
  color: var(--uc-ink-soft);
  margin: 0 0 2rem;
  font-variant-numeric: tabular-nums;
}
.uc-scanmeta__sep { margin: 0 0.4rem; opacity: 0.5; }

.uc-headline {
  background: var(--uc-bg-soft);
  border-left: 3px solid var(--uc-accent);
  padding: 1rem 1.25rem;
  margin-bottom: 2.5rem;
}
.uc-headline__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.35rem;
}
.uc-headline__line { font-size: 1.12rem; font-weight: 600; margin: 0; line-height: 1.45; }
.uc-headline--quiet .uc-headline__line { font-weight: 400; color: var(--uc-quiet); font-style: italic; }

.uc-cards { display: flex; flex-direction: column; gap: 0; }

/* Two columns from flex, and the fallback is the point: a client that does not
   implement flex lays both children out as blocks, which stacks the meta rail
   above the body — the same shape as the mobile layout. Outlook gets the
   phone's design for free and there is no second template to maintain. */
.uc-card {
  display: flex;
  gap: 1.5rem;
  border-top: 1px solid var(--uc-line);
  padding: 1.25rem 0;
}

.uc-card__meta {
  width: 190px;
  flex: 0 0 190px;
  border-right: 1px solid var(--uc-hairline);
  padding-right: 1.25rem;
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--uc-meta);
}
.uc-card__badges { margin: 0 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
.uc-card__byline { margin: 0 0 0.5rem; color: var(--uc-meta); }
.uc-card__was { color: var(--uc-faint); }
.uc-card__lens { margin: 0 0 0.5rem; color: var(--uc-faint); }
.uc-card__facets { margin: 0; color: var(--uc-faint); }
.uc-card__facets .uc-tag { color: var(--uc-meta); }
.uc-tag__sep { color: var(--uc-faint); }

.uc-card__body { flex: 1 1 auto; min-width: 0; }
.uc-card__title {
  font-family: var(--uc-font-serif);
  font-size: 1.12rem;
  font-weight: 650;
  margin: 0 0 0.45rem;
  line-height: 1.35;
  letter-spacing: -0.01em;
}
.uc-card__title a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--uc-line); }
.uc-card__title a:hover { border-bottom-color: var(--uc-accent); }

/* Three inks, three sizes. The hierarchy is weight and colour, not boxes. */
.uc-card__what { margin: 0 0 0.5rem; }
.uc-card__why { margin: 0 0 0.5rem; color: var(--uc-ink-soft); }
.uc-card__why-lead { font-style: normal; font-weight: 650; color: var(--uc-ink); }
.uc-card__caveats { margin: 0 0 0.5rem; font-size: 0.92rem; color: var(--uc-faint); }
.uc-card__pending {
  margin: 0 0 0.5rem;
  font-size: 0.92rem;
  color: var(--uc-faint);
  font-style: italic;
}

.uc-badge {
  display: inline-block;
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.15rem 0.4rem;
  border-radius: 2px;
}
/* Blue says an artifact exists; grey says a state. */
.uc-badge--artifact { background: var(--uc-badge-bg); color: var(--uc-accent); }
.uc-badge--state { background: var(--uc-chip-bg); color: var(--uc-meta); }

.uc-card__links { font-size: 0.82rem; margin: 0.5rem 0 0; }
.uc-card__links a { color: var(--uc-accent); text-decoration: none; }
.uc-card__links a:hover { text-decoration: underline; }
.uc-card__link-sep { color: var(--uc-faint); }

/* 640px, because that is where the 190px rail plus a readable measure stops
   fitting: below it the body column falls under about 45 characters, which is
   where line breaks start landing mid-phrase. The rail folds to the top of the
   card and its rule disappears — the same shape flex-less clients already get. */
@media (max-width: 640px) {
  .uc-card { flex-direction: column; gap: 0.5rem; }
  .uc-card__meta {
    width: auto;
    flex: none;
    border-right: 0;
    padding-right: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .uc-card__facets { font-style: italic; width: 100%; }
}

.uc-status-changes { margin-top: 3rem; border-top: 1px solid var(--uc-line); padding-top: 1rem; }
.uc-status-changes__title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.5rem;
}
.uc-status-changes ul { margin: 0; padding-left: 1.1rem; font-size: 0.88rem; color: var(--uc-ink-soft); }

.uc-footer {
  margin-top: 3rem;
  padding-top: 1rem;
  border-top: 1px solid var(--uc-line);
  font-size: 0.75rem;
  color: var(--uc-quiet);
}

/* `Also published today` — deliberately low-weight. These are records we could
   not read, so the section must not compete with the cards for attention; it
   sits after them, smaller, in the soft ink. */
.uc-also {
  margin-top: 3rem;
  border-top: 1px solid var(--uc-line);
  padding-top: 1rem;
}
.uc-also__title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--uc-ink-soft);
  margin: 0 0 0.4rem;
}
.uc-also__note {
  font-size: 0.82rem;
  color: var(--uc-quiet);
  margin: 0 0 0.9rem;
  max-width: 46rem;
}
.uc-also__list { list-style: none; padding: 0; margin: 0; }
.uc-also__item {
  font-size: 0.88rem;
  padding: 0.45rem 0;
  border-bottom: 1px solid var(--uc-line);
}
.uc-also__item:last-child { border-bottom: 0; }
.uc-also__item-title { display: block; color: var(--uc-ink); }
.uc-also__item-title a { color: var(--uc-ink); text-decoration: none; }
.uc-also__item-title a:hover { text-decoration: underline; }
.uc-also__byline {
  display: block;
  font-size: 0.78rem;
  color: var(--uc-ink-soft);
  margin-top: 0.15rem;
}
.uc-also__sep { padding: 0 0.35rem; color: var(--uc-quiet); }
.uc-also__tags { display: block; font-size: 0.75rem; margin-top: 0.2rem; }
.uc-tag--topic { color: var(--uc-ink-soft); }
/* Matched against the title alone, so it is shown as weaker evidence than a
   tag drawn from a full record. */
.uc-tag--from-title { color: var(--uc-quiet); font-style: italic; }

.uc-scanmeta__unreadable { color: var(--uc-quiet); }

.uc-attribution {
  margin-top: 0.8rem;
  font-size: 0.72rem;
  color: var(--uc-quiet);
  max-width: 46rem;
}

/* Synthesis layer (phase 0i). Block flow only — this has to hold together in
   an email client, where floats, grids and flex are unreliable. No colour
   carries meaning; the section is legible in plain text. */
.uc-synthesis {
  margin: 1.5rem 0 2rem;
  padding: 1rem 0 0;
  border-top: 1px solid #d9d9d9;
}
.uc-synthesis__paragraph {
  margin: 0 0 1.25rem;
  font-size: 1.02rem;
  line-height: 1.6;
}
.uc-synthesis__block { margin: 0 0 1rem; }
.uc-synthesis__title {
  margin: 0 0 0.35rem;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #666;
}
.uc-synthesis__list { margin: 0; padding-left: 1.1rem; line-height: 1.5; }
.uc-synthesis__list > li { margin-bottom: 0.3rem; }
.uc-synthesis__work { font-style: italic; }
.uc-synthesis__cite { color: #555; }
.uc-synthesis__shared {
  margin: 0.2rem 0 0.4rem;
  padding-left: 1rem;
  font-size: 0.9rem;
  color: #555;
}
.uc-synthesis__first { margin: 0.75rem 0 0; font-weight: 600; }
