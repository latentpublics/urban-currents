  "summary": {
    "en": {
      "caveats": null,
      "what": "The DREAM framework models occluded vehicular hazards using an advection-diffusion-reaction partial differential equation and integrates the generated risk field into Frenet-domain model predictive control via control barrier functions. Evaluated across CARLA simulations, ROS 2 hardware tests, and the inD dataset, the system aborted unsafe merges approximately one second prior to line-of-sight recovery, improved minimum clearance to hidden agents by 0.428 meters, and decreased collision or near-miss events from 29/30 to 19/30 in high-density scenarios.",
      "why": "This approach enables autonomous planners to proactively hedge against hidden dynamic hazards behind large vehicles without resorting to overly cautious slowdowns near unthreatened occlusions."
    }
  },
