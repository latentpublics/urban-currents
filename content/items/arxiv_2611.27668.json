  "summary": {
    "en": {
      "caveats": null,
      "what": "Statistical and machine learning models were developed to predict visitor counts in green and blue natural spaces across England and Wales. The models were trained on data from automated physical counters and evaluated on their capacity to accurately estimate visitation at previously unseen locations.",
      "why": "The framework provides a scalable method to track recreational pressure across diverse ecosystems without requiring the installation of permanent physical hardware or costly localized survey collection."
    }
