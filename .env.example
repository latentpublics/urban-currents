# OpenAlex API key. Free key from https://openalex.org/settings/api
# NOTE the variable name: OPENALEX_KEY (not OPENALEX_API_KEY).
# A free key raises the daily budget to $1/day; without a key the budget is $0.
OPENALEX_KEY=

# Anthropic API key used by the summarize stage.
ANTHROPIC_API_KEY=

# Contact address embedded in the arXiv User-Agent header (arXiv asks for one).
CONTACT_EMAIL=you@example.com
