  "summary": {
    "en": {
      "caveats": "The guide is a qualitative, practice-oriented manual rather than an empirical study with quantitative data or measurable outcomes.",
      "what": "This guide outlines strategic frameworks and tactical approaches for transportation advocacy in the United States, focusing on campaigns to reduce car dominance and promote sustainable transit alternatives.",
      "why": "It provides grassroots organizers and planners with a structured playbook for navigating political and institutional resistance to transit reform, turning abstract policy goals into actionable campaign strategies."
    }
