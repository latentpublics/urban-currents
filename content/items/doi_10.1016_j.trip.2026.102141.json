  "summary": {
    "en": {
      "caveats": null,
      "what": "This perspective paper synthesizes research across neuroscience, robotics, and behavioral science to map how autonomous vehicles (AVs) and humans represent and act under uncertainty. It establishes a shared two-stage framework of control under partial information—probabilistic inference followed by risk-weighted action selection—to bridge the gap between mathematical risk models, robotic planning, and human psychological uncertainty.",
      "why": "It establishes human psychological uncertainty as a concrete, behaviorally relevant variable for AV engineering, providing a conceptual pathway to design self-driving systems that actively model and reduce the uncertainty of the humans sharing the road with them."
    }
  },
